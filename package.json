{
  "name": "cedar-escape-cabin",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler pages dev . --compatibility-date=2026-09-01",
    "db:migrate:local": "wrangler d1 execute cedar-escape-massage --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute cedar-escape-massage --remote --file=./migrations/0001_init.sql",
    "db:migrate:local:rewards": "wrangler d1 execute cedar-escape-rewards --local --file=./migrations/0002_rewards_init.sql",
    "db:migrate:remote:rewards": "wrangler d1 execute cedar-escape-rewards --remote --file=./migrations/0002_rewards_init.sql"
  },
  "devDependencies": {
    "wrangler": "^3"
  },
  "allowScripts": {
    "esbuild@0.17.19": true,
    "workerd@1.20250718.0": true,
    "sharp@0.33.5": true
  }
}
